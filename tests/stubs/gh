#!/bin/bash
# gh stub: logs every call to $STUB_LOG; behavior driven by files in $STUB_DIR.
#   prs.json      JSON array returned by `gh pr list --json`
#   gh-fail       if present, every command fails with exit 1
#   gh-logged-out `gh api ...` fails with a 401 message
#   rate_limit.json returned by `gh api rate_limit` (healthy default when absent)
#   pr-list-limited `gh pr list` fails with a rate-limit message
#   merge-fail  if present, `gh pr merge` fails
#   pr-N-open     if present, `gh pr view N --json state` reports OPEN (else MERGED)
#   login         login for `gh api user` and `gh config get user` (default octocat)
#   graphql.json  body for `gh api graphql` (default: empty result for every alias);
#                 exits 1 when it has a top-level "errors" key, like real gh
#   graphql-fail  `gh api graphql` fails with no body
#   notifications.json  body for `gh api notifications?per_page=50` (default [])
#   notifications-forbidden  that call fails with an HTTP 403 (no rate-limit/auth wording)
#   notifications-fail       that call fails with HTTP 500
#   patch-fail    `gh api --method PATCH notifications/threads/N` fails (else silent success)
#   put-fail      `gh api --method PUT notifications ...` fails (else silent success)
#   runs-O-R.json body for `gh api repos/O/R/actions/runs?per_page=30` (default {"workflow_runs":[]})
#   runs-fail     every actions/runs call fails with HTTP 500
#   runs-fail-O-R that repo's actions/runs call fails with HTTP 500
# `gh pr merge` performs a real merge in the bare origin so ff/prune have
# something to act on.
printf 'gh %s\n' "$*" >> "$STUB_LOG"
[[ -e $STUB_DIR/gh-fail ]] && { echo "gh: authentication required" >&2; exit 1; }
[[ $1 == api && -e $STUB_DIR/gh-logged-out ]] && { echo "gh: Bad credentials (HTTP 401)" >&2; exit 1; }
if [[ $1 == api && $2 == --method ]]; then
  case "$3 $4" in
    "PATCH notifications/threads/"*) [[ -e $STUB_DIR/patch-fail ]] && { echo "gh: HTTP 500: patch failed" >&2; exit 1; }; exit 0 ;;
    "PUT notifications") [[ -e $STUB_DIR/put-fail ]] && { echo "gh: HTTP 500: put failed" >&2; exit 1; }; exit 0 ;;
  esac
fi
case "$1 $2" in
  "api notifications?per_page=50")
    [[ -e $STUB_DIR/notifications-forbidden ]] && { echo "gh: Resource not accessible by personal access token (HTTP 403)" >&2; exit 1; }
    [[ -e $STUB_DIR/notifications-fail ]] && { echo "gh: HTTP 500: server error" >&2; exit 1; }
    cat "$STUB_DIR/notifications.json" 2>/dev/null || echo "[]" ;;
  "api repos/"*"/actions/runs?per_page=30")
    nwo=${2#repos/}; nwo=${nwo%%/actions/*}
    [[ -e $STUB_DIR/runs-fail || -e $STUB_DIR/runs-fail-${nwo//\//-} ]] && { echo "gh: HTTP 500: server error" >&2; exit 1; }
    cat "$STUB_DIR/runs-${nwo//\//-}.json" 2>/dev/null || echo '{"workflow_runs":[]}' ;;
  "api rate_limit")
    cat "$STUB_DIR/rate_limit.json" 2>/dev/null \
      || echo '{"resources":{"core":{"limit":5000,"remaining":4999,"reset":0},"graphql":{"limit":5000,"remaining":4999,"reset":0}}}' ;;
  "api user")
    login=$(cat "$STUB_DIR/login" 2>/dev/null || echo octocat)
    if [[ " $* " == *" --jq .login "* || " $* " == *" -q .login "* ]]; then echo "$login"
    else printf '{"login":"%s"}\n' "$login"; fi ;;
  "api graphql")
    [[ -e $STUB_DIR/graphql-fail ]] && { echo "gh: graphql: connection reset" >&2; exit 1; }
    if [[ -f $STUB_DIR/graphql.json ]]; then
      cat "$STUB_DIR/graphql.json"
      jq -e 'has("errors")' "$STUB_DIR/graphql.json" >/dev/null 2>&1 && exit 1
    else
      echo '{"data":{"reviews":{"nodes":[]},"prs":{"nodes":[]},"issues":{"nodes":[]}}}'
    fi ;;
  "config get")
    cat "$STUB_DIR/login" 2>/dev/null || echo octocat ;;
  "pr list")
    [[ -e $STUB_DIR/pr-list-limited ]] && { echo "gh: API rate limit exceeded (HTTP 403)" >&2; exit 1; }
    cat "$STUB_DIR/prs.json" 2>/dev/null || echo "[]" ;;
  "pr view")
    if [[ $3 =~ ^[0-9]+$ ]]; then   # gh pr view N --json f -q .f
      num=$3; shift 3; fields=""; q=""
      while (($#)); do case "$1" in --json) fields=$2; shift 2 ;; -q) q=$2; shift 2 ;; *) shift ;; esac; done
      state=MERGED; [[ -e $STUB_DIR/pr-$num-open ]] && state=OPEN
      jq -c --argjson n "$num" --arg s "$state" --arg f "$fields" \
        '.[] | select(.number == $n) | {headRefName, state: $s} | with_entries(select(.key | IN($f | split(",")[])))' \
        "$STUB_DIR/prs.json" | { [[ -n $q ]] && jq -r "$q" || cat; }
      exit 0
    fi
    branch=$(git symbolic-ref --short -q HEAD)
    url=$(jq -r --arg b "$branch" '.[] | select(.headRefName == $b) | .url' "$STUB_DIR/prs.json" 2>/dev/null | head -n1)
    [[ -n $url ]] || { echo "no pull requests found for branch \"$branch\"" >&2; exit 1; }
    if [[ " $* " == *" -q "* ]]; then echo "$url"; else printf '{"url":"%s"}\n' "$url"; fi ;;
  "pr create")
    echo "https://github.com/example/repo/pull/42" ;;
  "pr merge")
    [[ -e $STUB_DIR/merge-fail ]] && { echo "GraphQL: Pull request is not mergeable" >&2; exit 1; }
    num=$3; shift 3
    strategy=""; delete=0
    for a in "$@"; do case "$a" in --squash|--merge|--rebase) strategy=${a#--} ;; --delete-branch) delete=1 ;; esac; done
    head=$(jq -r --argjson n "$num" '.[] | select(.number == $n) | .headRefName' "$STUB_DIR/prs.json")
    origin=$(git remote get-url origin)
    scratch=$(mktemp -d)
    git clone -q "$origin" "$scratch/w"
    def=$(git -C "$scratch/w" symbolic-ref --short HEAD)
    if [[ $strategy == squash ]]; then
      git -C "$scratch/w" merge -q --squash "origin/$head" && git -C "$scratch/w" commit -qm "Squash #$num ($head)"
    elif [[ $strategy == rebase ]]; then
      git -C "$scratch/w" merge -q --ff-only "origin/$head"
    else
      git -C "$scratch/w" merge -q --no-ff -m "Merge #$num ($head)" "origin/$head"
    fi
    git -C "$scratch/w" push -q origin "$def"
    if (( delete )); then
      git -C "$scratch/w" push -q origin --delete "$head"
      if [[ $(git symbolic-ref --short -q HEAD) == "$head" ]]; then
        git switch -q "$def" 2>/dev/null; git branch -q -D "$head" 2>/dev/null
      fi
    fi
    rm -rf "$scratch"
    echo "✓ ${strategy} merged pull request #$num" ;;
  *) echo "gh stub: unhandled $*" >&2; exit 1 ;;
esac
