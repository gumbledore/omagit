#!/bin/bash
# omagit-inbox fetch [<tracked-repo>...] | cached | mark-read <id> | mark-all <ts> <id>...:
# the account-wide GitHub inbox. GraphQL query ideas and the mark-all boundary
# technique borrowed from robzolkos/omarchy-github (MIT).
#
#   fetch   GH       state(ok|missing|missing-scope|logged-out|rate-limited)  reset_epoch  message
#           LOGIN    login                       (only when gh api user succeeded)
#           NOTIF    thread_id  owner/repo  title  reason  type  url  updatedAt  localPath
#           REVIEW   owner/repo  number  title  url  author  updatedAt  localPath
#           MYPR     owner/repo  number  title  url  ci(passing|failing|pending|none)
#                    updatedAt  localPath  draft(0|1)
#           ISSUE    owner/repo  number  title  url  updatedAt  localPath
#           RUN      owner/repo  run_id  workflow  title  url  state(running|failed)
#                    branch  updatedAt  localPath
#           SECTION  notifications|reviews|prs|issues|actions  OK|ERR|SKIP  message
#                    (OK message = item count; emitted in that order)
#           INBOXDONE  epoch
#     Drafts (review requests) and archived-repo items are filtered out; sections
#     are capped at 50. localPath is the tracked repo whose github origin matches
#     (case-insensitive), else empty. gh not ok -> every section SKIP, no cache write.
#     A section that fails (null alias / named in errors[].path / REST error) is ERR;
#     the others render. A notifications 403/404 means the token lacks the scope:
#     GH missing-scope + SECTION SKIP. Actions: REST per distinct tracked
#     github.com repo (only those); running = in progress/queued/..., failed = latest
#     run of its workflow+branch, failed/timed out, updated within 3 days. A repo
#     whose call fails is skipped; the section is ERR only when every call failed.
#   cached  no network. Prints the cache file when its login equals gh's current
#           login (gh config), else deletes it and prints nothing.
#   mark-read <thread-id>   PATCH the thread read; ends RESULT OK|ERR message.
#   mark-all <newest-shown-timestamp YYYY-MM-DDTHH:MM:SSZ> <thread-id>...
#           PUT everything strictly before that second, then PATCH each id (the
#           shown threads at the boundary second); ends RESULT OK|ERR message.
#
# Cache $OMAGIT_CACHE_DIR/inbox.tsv: line 1 `CACHE<TAB>login<TAB>epoch`, then the
# item/SECTION records exactly as emitted. Written only when the login resolved, no
# section is ERR/SKIP, and gh was healthy; a notifications SKIP for a missing scope
# does not count. Successful marks prune the cache; a partly failed mark-all deletes it.

source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../lib/common.sh"

CACHE_FILE="$OMAGIT_CACHE_DIR/inbox.tsv"
SECTIONS=(notifications reviews prs issues actions)

QUERY='query {
  reviews: search(query: "is:open is:pr review-requested:@me archived:false draft:false", type: ISSUE, first: 50) { nodes { ...pr } }
  prs: search(query: "is:open is:pr author:@me archived:false", type: ISSUE, first: 50) { nodes { ...pr } }
  issues: search(query: "is:open is:issue assignee:@me archived:false", type: ISSUE, first: 50) {
    nodes { ... on Issue { number title url updatedAt repository { nameWithOwner isArchived } } }
  }
}
fragment pr on PullRequest {
  number title url isDraft updatedAt author { login }
  repository { nameWithOwner isArchived }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}'

JQ='
def clean: tostring | gsub("[\t\r\n]"; " ");
def ci: (.commits.nodes[0].commit.statusCheckRollup.state // "") as $s
  | if $s == "SUCCESS" then "passing"
    elif $s == "FAILURE" or $s == "ERROR" then "failing"
    elif $s == "PENDING" or $s == "EXPECTED" then "pending"
    else "none" end;
def lp: $paths[.repository.nameWithOwner | ascii_downcase] // "";
def row: map(clean) | join("\t");
def errmsg($a): ([.errors[]? | select((.path // [])[0] == $a) | .message][0])
  // (if .data[$a] == null then ([.errors[]?.message][0] // "no data") else null end);
def section($a): . as $r | ($r | errmsg($a)) as $e
  | if $e != null then ["SECTION", $a, "ERR", $e] | row
    else
      ([$r.data[$a].nodes[]? | select(.number != null and .repository.isArchived != true)
        | select($a != "reviews" or .isDraft != true)] | .[:50]) as $items
      | ($items[] | if $a == "reviews"
          then ["REVIEW", .repository.nameWithOwner, .number, .title, .url, (.author.login // ""), .updatedAt, lp]
          elif $a == "issues"
          then ["ISSUE", .repository.nameWithOwner, .number, .title, .url, .updatedAt, lp]
          else ["MYPR", .repository.nameWithOwner, .number, .title, .url, ci, .updatedAt, lp, (if .isDraft then "1" else "0" end)]
          end | row),
        (["SECTION", $a, "OK", ($items | length)] | row)
    end;
section("reviews"), section("prs"), section("issues")'

NOTIF_JQ='
def clean: tostring | gsub("[\t\r\n]"; " ");
def row: map(clean) | join("\t");
def weburl: (.subject.url // "") as $u
  | if ($u | test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/pulls/[0-9]+$"))
      then $u | sub("^https://api\\.github\\.com/repos/"; "https://github.com/") | sub("/pulls/"; "/pull/")
    elif ($u | test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/issues/[0-9]+$"))
      then $u | sub("^https://api\\.github\\.com/repos/"; "https://github.com/")
    elif ($u | test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/commits/[0-9a-f]+$"))
      then $u | sub("^https://api\\.github\\.com/repos/"; "https://github.com/") | sub("/commits/"; "/commit/")
    else .repository.html_url // "" end;
[.[]? | select(.id != null)] | .[:50] as $items
| ($items[] | ["NOTIF", .id, (.repository.full_name // ""), .subject.title, .reason, .subject.type, weburl, .updated_at,
    ($paths[(.repository.full_name // "") | ascii_downcase] // "")] | row),
  (["SECTION", "notifications", "OK", ($items | length)] | row)
'

RUN_JQ='
def clean: tostring | gsub("[\t\r\n]"; " ");
def row: map(clean) | join("\t");
def ts: try fromdateiso8601 catch 0;
(.workflow_runs // []) as $runs
| ($runs | group_by([.workflow_id, .head_branch] | tostring)
    | map({key: (.[0] | [.workflow_id, .head_branch] | tostring), value: (map(.created_at) | max)}) | from_entries) as $latest
| [$runs[]
   | (if (.status | IN("in_progress", "queued", "waiting", "requested", "pending")) then "running"
      elif .status == "completed" and (.conclusion | IN("failure", "timed_out", "startup_failure"))
        and .created_at == $latest[[.workflow_id, .head_branch] | tostring]
        and ((.updated_at // "" | ts) >= $now - 259200) then "failed"
      else empty end) as $st
   | {r: ., st: $st}]
| sort_by(.r.updated_at) | reverse | .[]
| ["RUN", (.r.repository.full_name // $repo), .r.id, .r.name, .r.display_title, .r.html_url, .st, .r.head_branch, .r.updated_at, ($paths[$repo] // "")] | row
'

# owner/repo (lowercase) from a github.com origin URL, or nothing.
origin_nwo() {
  local u=${1%/}; u=${u%.git}
  [[ $u =~ ^(https?://([^@/]+@)?|ssh://git@|git@)github\.com[:/]([^/]+/[^/]+)$ ]] || return 0
  printf '%s\n' "${BASH_REMATCH[3],,}"
}

sections() { # <status> <message> for every section
  local n
  for n in "${SECTIONS[@]}"; do tsv SECTION "$n" "$1" "$2"; done
}

first_line() { head -n1 <<<"$1"; }

# gh_get <endpoint>: sets G_OUT (stdout) and G_ERR (first line of stderr, else stdout).
gh_get() {
  local errf rc; errf=$(mktemp)
  G_OUT=$(with_timeout gh api "$1" 2>"$errf"); rc=$?
  G_ERR=$(first_line "$(<"$errf")"); rm -f "$errf"
  [[ -n $G_ERR ]] || G_ERR=$(first_line "$G_OUT")
  [[ -n $G_ERR ]] || G_ERR="gh api failed (exit $rc)"
  return "$rc"
}

# gh_get_method <METHOD> <endpoint> [gh args...]: like gh_get for a write call.
gh_get_method() {
  local errf rc m=$1 ep=$2; shift 2; errf=$(mktemp)
  G_OUT=$(with_timeout gh api --method "$m" "$ep" "$@" 2>"$errf"); rc=$?
  G_ERR=$(first_line "$(<"$errf")"); rm -f "$errf"
  [[ -n $G_ERR ]] || G_ERR="gh api $m failed (exit $rc)"
  return "$rc"
}

# Notifications records (or a GH record + SKIP section for auth/rate-limit/scope problems).
fetch_notifications() { # <paths-json>
  local st
  if gh_get "notifications?per_page=50"; then
    jq -r --argjson paths "$1" "$NOTIF_JQ" <<<"$G_OUT" 2>/dev/null \
      || tsv SECTION notifications ERR "could not parse notifications"
    return
  fi
  st=$(gh_classify_error "$G_ERR")
  if [[ -n $st ]]; then tsv GH "$st" "" "gh $st"; tsv SECTION notifications SKIP "gh $st"
  elif grep -qE 'HTTP (403|404)' <<<"$G_ERR"; then
    tsv GH missing-scope "" notifications; tsv SECTION notifications SKIP "missing notifications scope"
  else tsv SECTION notifications ERR "$G_ERR"; fi
}

# Running / recently failed workflow runs for each distinct tracked github repo.
fetch_runs() { # <paths-json>
  local nwo st ok=0 bad=0 err="" rows="" part
  while IFS= read -r nwo; do
    [[ -n $nwo ]] || continue
    if gh_get "repos/$nwo/actions/runs?per_page=30"; then
      ok=$((ok + 1))
      part=$(jq -r --arg repo "$nwo" --argjson now "$(now)" --argjson paths "$1" "$RUN_JQ" <<<"$G_OUT" 2>/dev/null)
      [[ -z $part ]] || rows+=$part$'\n'
    else
      st=$(gh_classify_error "$G_ERR")
      if [[ -n $st ]]; then tsv GH "$st" "" "gh $st"; tsv SECTION actions SKIP "gh $st"; return; fi
      bad=$((bad + 1)); [[ -n $err ]] || err=$G_ERR
    fi
  done < <(jq -r 'keys[]' <<<"$1" | sort)
  if (( ok == 0 && bad > 0 )); then tsv SECTION actions ERR "$err"; return; fi
  rows=$(grep -v '^$' <<<"$rows" | head -n 50 || true)
  [[ -z $rows ]] || printf '%s\n' "$rows"
  tsv SECTION actions OK "$([[ -z $rows ]] && echo 0 || wc -l <<<"$rows" | tr -d ' ')"
}

cmd_fetch() {
  local rec state login out err rc errf st body paths lines r nwo notif runs extra
  rec=$(gh_status); printf '%s\n' "$rec"
  state=$(cut -f2 <<<"$rec")
  if [[ $state != ok ]]; then sections SKIP "gh $state"; tsv INBOXDONE "$(now)"; return; fi

  login=$(with_timeout gh api user --jq .login 2>&1); rc=$?
  if (( rc != 0 )) || [[ -z $login ]]; then
    st=$(gh_classify_error "$login")
    if [[ -n $st ]]; then tsv GH "$st" "" "gh $st"; sections SKIP "gh $st"
    else sections ERR "${login:-gh api user failed (exit $rc)}"; fi
    tsv INBOXDONE "$(now)"; return
  fi
  tsv LOGIN "$login"

  errf=$(mktemp); out=$(with_timeout gh api graphql -f query="$QUERY" 2>"$errf"); rc=$?
  err=$(<"$errf"); rm -f "$errf"
  if ! jq -e '.data | type == "object"' <<<"$out" >/dev/null 2>&1; then
    st=$(gh_classify_error "$out $err")
    if [[ -n $st ]]; then tsv GH "$st" "" "gh $st"; sections SKIP "gh $st"
    else
      st=$(jq -r '.errors[0].message // empty' <<<"$out" 2>/dev/null)
      sections ERR "$(head -n1 <<<"${st:-${err:-${out:-gh api graphql failed (exit $rc)}}}")"
    fi
    tsv INBOXDONE "$(now)"; return
  fi

  paths="{}"
  if (( $# > 0 )); then
    paths=$(for r in "$@"; do
      nwo=$(origin_nwo "$(git -C "$r" config --get remote.origin.url 2>/dev/null)")
      [[ -n $nwo ]] && printf '%s\t%s\n' "$nwo" "$r"
    done | jq -R -s 'split("\n") | map(select(. != "") | split("\t")) | reduce .[] as $p ({}; if has($p[0]) then . else .[$p[0]] = $p[1] end)')
  fi
  if ! lines=$(jq -r --argjson paths "$paths" "$JQ" <<<"$out" 2>/dev/null); then
    sections ERR "could not parse gh output"; tsv INBOXDONE "$(now)"; return
  fi
  # GH records from the REST sections print first; the cache keeps item records only.
  notif=$(fetch_notifications "$paths"); runs=$(fetch_runs "$paths")
  extra=$(grep -P '^GH\t' <<<"$notif"$'\n'"$runs" || true)
  body=$(grep -vP '^GH\t' <<<"$notif"$'\n'"$lines"$'\n'"$runs" | grep -v '^$')
  [[ -z $extra ]] || printf '%s\n' "$extra"
  printf '%s\n' "$body"

  # a classified GH error always comes with a SKIP section, so the SECTION scan covers it
  if ! { grep -P '^SECTION\t\w+\t(ERR|SKIP)\t' <<<"$body" | grep -vqxP 'SECTION\tnotifications\tSKIP\tmissing notifications scope'; }; then
    mkdir -p "$OMAGIT_CACHE_DIR"
    { tsv CACHE "$login" "$(now)"; printf '%s\n' "$body"; } > "$CACHE_FILE.tmp" && mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
  fi
  tsv INBOXDONE "$(now)"
}

cmd_cached() {
  local cur cached
  [[ -f $CACHE_FILE ]] || return 0
  cur=$(with_timeout gh config get user -h github.com 2>/dev/null)
  cached=$(head -n1 "$CACHE_FILE" | cut -f2)
  if [[ -n $cur && ${cur,,} == "${cached,,}" ]]; then cat "$CACHE_FILE"; else rm -f "$CACHE_FILE"; fi
}

# Drop cached NOTIF lines (by thread id and/or updatedAt <= timestamp) and fix the count.
prune_cache() { # <id|""> <timestamp|"">
  [[ -f $CACHE_FILE ]] || return 0
  awk -F'\t' -v id="$1" -v ts="$2" '
    $1 == "NOTIF" && ((id != "" && $2 == id) || (ts != "" && $8 <= ts)) { next }
    { line[++n] = $0; if ($1 == "NOTIF") c++ }
    END { for (i = 1; i <= n; i++) {
            if (line[i] ~ /^SECTION\tnotifications\tOK\t/) print "SECTION\tnotifications\tOK\t" c + 0
            else print line[i] } }' "$CACHE_FILE" > "$CACHE_FILE.tmp" && mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
}

fail_result() { tsv RESULT ERR "$1"; exit 1; }

cmd_mark_read() {
  local id=${1:-}
  [[ $id =~ ^[0-9]+$ ]] || fail_result "invalid thread id"
  gh_get_method PATCH "notifications/threads/$id" || fail_result "$G_ERR"
  prune_cache "$id" ""
  tsv RESULT OK "marked read"
}

cmd_mark_all() {
  local ts=${1:-} id before failed=0 total
  shift || true
  [[ $ts =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] && before=$(date -u -d "$ts" +%s 2>/dev/null) \
    || fail_result "invalid timestamp (want YYYY-MM-DDTHH:MM:SSZ)"
  (( $# > 0 )) || fail_result "no thread ids"
  for id in "$@"; do [[ $id =~ ^[0-9]+$ ]] || fail_result "invalid thread id"; done
  total=$#
  # Boundary technique from robzolkos/omarchy-github (MIT): bulk-mark everything strictly
  # before the boundary second, then mark the threads at that second by id.
  gh_get_method PUT notifications -f "last_read_at=$(date -u -d "@$((before - 1))" +%Y-%m-%dT%H:%M:%SZ)" || fail_result "$G_ERR"
  for id in "$@"; do gh_get_method PATCH "notifications/threads/$id" || failed=$((failed + 1)); done
  if (( failed )); then
    rm -f "$CACHE_FILE"
    fail_result "$failed of $total thread updates failed"
  fi
  prune_cache "" "$ts"
  tsv RESULT OK "all shown marked read"
}

case "${1:-}" in
  fetch) shift; cmd_fetch "$@" ;;
  cached) cmd_cached ;;
  mark-read) shift; cmd_mark_read "$@" ;;
  mark-all) shift; cmd_mark_all "$@" ;;
  *) die "usage: omagit-inbox fetch [<repo>...] | cached | mark-read <id> | mark-all <timestamp> <id>..." ;;
esac
